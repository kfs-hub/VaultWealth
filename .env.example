# VaultWealth Environment Variables
# Copy to .env for local testing (node server.js), and set in Vercel Settings -> Environment Variables

# 1. Google Gemini API Key (Required for the AI Financial Assistant)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override default Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase Configuration (Optional - defaults are already baked in)
# SUPABASE_URL=https://czdnalkrtvuvvevvtdds.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_jlg2rxNKKwarCkLLhJjeTw_xmWu24Wt
