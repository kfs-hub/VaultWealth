# Non-frontend directories — excluded from Vercel bundle
database/
ml/
ui/
.git/

# Python files (prevents Vercel from treating project as a Python serverless app)
*.py
*.pyc
*.pyo
requirements.txt
pyproject.toml
setup.py
setup.cfg
__pycache__/

# Scratch & dev-only files
*.xlsx
*.csv
AccountStatement*.xlsx
